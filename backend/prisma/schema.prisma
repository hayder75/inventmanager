// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT
}

enum StockEntryStatus {
  FULLY_PAID
  PARTIALLY_PAID
  ON_CREDIT
}

enum StockAdjustmentReason {
  DAMAGE
  THEFT
  GIFT
  CORRECTION
  COUNT_ERROR
  EXPIRED
  RETURNED
  OTHER
}

enum ExpenseType {
  RENT
  UTILITIES
  SALARIES
  COMMISSION
  SUPPLIES
  MARKETING
  TRANSPORTATION
  MAINTENANCE
  INSURANCE
  TAXES
  OTHER
}

// Users table
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role
  isActive      Boolean  @default(true) @map("is_active")
  totalCommission Decimal @default(0) @map("total_commission") @db.Decimal(12, 2) // Total commission earned (resettable by admin)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  sales         Sale[]
  payments      PaymentReceived[]
  stockAdjustments StockAdjustment[]
  contacts      Contact[]
  expenses      Expense[]
  dailyOpeningBalances DailyOpeningBalance[]

  @@map("users")
}

// Companies (credit customers only)
model Company {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  address       String?
  creditLimit   Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(12, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  sales         Sale[]
  payments      PaymentReceived[]

  @@map("companies")
}

// Contact List (quick phone book)
model Contact {
  id            String   @id @default(uuid())
  name          String
  phone         String
  notes         String?  @db.Text
  visibleToSales Boolean @default(true) @map("visible_to_sales")
  createdBy    String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  creator       User     @relation(fields: [createdBy], references: [id])

  @@map("contacts")
}

// Products
model Product {
  id            String   @id @default(uuid())
  name          String
  code          String?  @unique
  category      String?
  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  lowStockAlert Int      @default(10) @map("low_stock_alert")
  stockQty      Int      @default(0) @map("stock_qty")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  stockEntries  StockEntry[]
  saleItems     SaleItem[]
  stockAdjustments StockAdjustment[]

  @@map("products")
}

// Stock Entries (replaces old purchases - unified Add Stock flow)
model StockEntry {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  quantity      Int
  costPrice     Decimal  @map("cost_price") @db.Decimal(12, 2)
  batchNumber   String?  @map("batch_number")
  expiryDate    DateTime? @map("expiry_date") @db.Date
  supplierName  String   @map("supplier_name")
  status        StockEntryStatus @default(FULLY_PAID)
  owedAmount    Decimal  @default(0) @map("owed_amount") @db.Decimal(12, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  product       Product  @relation(fields: [productId], references: [id])
  supplierPayments SupplierPayment[]

  @@map("stock_entries")
}

// Stock Adjustments (manual corrections)
model StockAdjustment {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  qtyChange     Int      @map("qty_change") // positive = increase, negative = decrease
  reason        StockAdjustmentReason
  notes         String?  @db.Text
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  product       Product  @relation(fields: [productId], references: [id])
  creator       User     @relation(fields: [createdBy], references: [id])

  @@map("stock_adjustments")
}

// Sales
model Sale {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number")
  companyId     String?  @map("company_id") // null for walk-in
  walkinName    String?  @map("walkin_name")
  walkinPhone   String?  @map("walkin_phone")
  subtotal      Decimal  @map("subtotal") @db.Decimal(12, 2) // Subtotal before taxes (salesperson's prices)
  vatAmount     Decimal  @default(0) @map("vat_amount") @db.Decimal(12, 2) // VAT amount
  totAmount      Decimal  @default(0) @map("tot_amount") @db.Decimal(12, 2) // TOT amount
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2) // Total after taxes
  totalPaid     Decimal  @default(0) @map("total_paid") @db.Decimal(12, 2)
  totalCredit   Decimal  @default(0) @map("total_credit") @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2) // Commission amount
  bankType      String?  @map("bank_type") // Bank type for bank transfers (CBE, ABYSSINYA, AWASH, TELEBIRR, or OTHER:name)
  salespersonId String  @map("salesperson_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  company       Company? @relation(fields: [companyId], references: [id])
  salesperson   User     @relation(fields: [salespersonId], references: [id])
  items         SaleItem[]
  payments      PaymentReceived[]

  @@map("sales")
}

// Sale Items (tracks price overrides)
model SaleItem {
  id            String   @id @default(uuid())
  saleId        String   @map("sale_id")
  productId     String   @map("product_id")
  quantity      Int
  adminPrice    Decimal  @map("admin_price") @db.Decimal(12, 2) // original admin price
  overriddenPrice Decimal? @map("overridden_price") @db.Decimal(12, 2) // salesperson override (can only increase)
  finalPrice    Decimal  @map("final_price") @db.Decimal(12, 2) // what customer actually paid
  subtotal      Decimal  @db.Decimal(12, 2)
  // Surplus management fields
  surplusAmount Decimal? @default(0) @map("surplus_amount") @db.Decimal(12, 2) // total surplus (finalPrice - adminPrice) * quantity
  adminCutAmount Decimal? @default(0) @map("admin_cut_amount") @db.Decimal(12, 2) // amount admin takes from surplus
  adminCutPercentage Decimal? @map("admin_cut_percentage") @db.Decimal(5, 2) // percentage admin takes (if using percentage)
  remainingSurplus Decimal? @default(0) @map("remaining_surplus") @db.Decimal(12, 2) // surplus after admin's cut
  salespersonGetsCommission Boolean @default(false) @map("salesperson_gets_commission") // checkbox if salesperson gets commission
  salespersonCommissionAmount Decimal? @default(0) @map("salesperson_commission_amount") @db.Decimal(12, 2) // commission amount for salesperson
  salespersonCommissionPercentage Decimal? @map("salesperson_commission_percentage") @db.Decimal(5, 2) // commission percentage (if using percentage)
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

// Payments Received from Companies
model PaymentReceived {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  saleId        String?  @map("sale_id") // Optional: link to specific sale
  amount        Decimal  @db.Decimal(12, 2)
  method        PaymentMethod
  salespersonId String   @map("salesperson_id")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  company       Company  @relation(fields: [companyId], references: [id])
  salesperson   User     @relation(fields: [salespersonId], references: [id])
  sale          Sale?    @relation(fields: [saleId], references: [id])

  @@map("payments_received")
}

// Supplier Payments
model SupplierPayment {
  id            String   @id @default(uuid())
  stockEntryIds String[] @map("stock_entry_ids") // array of stock entry IDs being paid
  amount        Decimal  @db.Decimal(12, 2)
  method        PaymentMethod
  supplierName  String   @map("supplier_name")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  stockEntries  StockEntry[]

  @@map("supplier_payments")
}

// Expenses
model Expense {
  id            String     @id @default(uuid())
  expenseType   ExpenseType @map("expense_type")
  expenseDate   DateTime   @map("expense_date") @db.Date
  description   String     @db.Text
  amount        Decimal    @db.Decimal(12, 2)
  paymentMethod PaymentMethod // CASH or BANK_TRANSFER
  createdBy     String     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  creator       User       @relation(fields: [createdBy], references: [id])

  @@map("expenses")
}

// Settings
model Setting {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String   @db.Text
  description   String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by")

  @@map("settings")
}

// Daily Opening Balances (manual entries for specific days)
model DailyOpeningBalance {
  id            String   @id @default(uuid())
  date          DateTime @unique @db.Date // Date for this opening balance
  amount        Decimal  @db.Decimal(12, 2) // Opening balance amount
  notes         String?  @db.Text // Optional notes
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  creator       User     @relation(fields: [createdBy], references: [id])

  @@map("daily_opening_balances")
}

// Public website products (different from inventory products)
model PublicProduct {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  imageUrl      String?  @map("image_url") // Path to uploaded image
  price         Decimal? @db.Decimal(12, 2) // Display price (optional)
  category      String?
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("public_products")
}

// Website settings
model WebsiteSetting {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String   @db.Text
  description   String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by")

  @@map("website_settings")
}

